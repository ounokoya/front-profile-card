sionNonce": 509342021}, {"id": "pc-2b-t", "type": "text", "x": 81264, "y": 1857, "width": 374, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "c1OP", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "2B \u00b7 Contrastes (AA : 4,5:1 texte)", "roughness": 1, "roundness": null, "seed": 412147262, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "2B \u00b7 Contrastes (AA : 4,5:1 texte)", "textAlign": "left", "updated": 1793904876558, "version": 1, "versionNonce": 1901247786, "verticalAlign": "top"}, {"id": "pc-2b-b", "type": "text", "x": 81264, "y": 1901, "width": 1192, "height": 80, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 16, "frameId": null, "groupIds": [], "index": "c1OQ", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "\u2022\u00a0\u00a0OK : nom et chiffres Navy 950 12,62:1 ; \u00e2ge, ville, libell\u00e9s\n\u00a0\u00a0\u00a0\u00a0\u00a0Gray 500 5,02:1 (sur blanc).\n\u2022\u00a0\u00a0Insuffisant : attribution sur Blue 600 \u2014 lien #3E52A3 2,32:1,\n\u00a0\u00a0\u00a0\u00a0\u00a0texte Navy 950 4,08:1 (Q-A1).\u00a0\u00a0\u00a0\u2022\u00a0\u00a0Trait Gray 100 : d\u00e9coratif.", "roughness": 1, "roundness": null, "seed": 582778952, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "\u2022\u00a0\u00a0OK : nom et chiffres Navy 950 12,62:1 ; \u00e2ge, ville, libell\u00e9s\n\u00a0\u00a0\u00a0\u00a0\u00a0Gray 500 5,02:1 (sur blanc).\n\u2022\u00a0\u00a0Insuffisant : attribution sur Blue 600 \u2014 lien #3E52A3 2,32:1,\n\u00a0\u00a0\u00a0\u00a0\u00a0texte Navy 950 4,08:1 (Q-A1).\u00a0\u00a0\u00a0\u2022\u00a0\u00a0Trait Gray 100 : d\u00e9coratif.", "textAlign": "left", "updated": 1793904876558, "version": 1, "versionNonce": 1024690018, "verticalAlign": "top"}, {"id": "pc-2d-box", "type": "rectangle", "x": 79980, "y": 2057, "width": 2520, "height": 270, "angle": 0, "backgroundColor": "#fff5f5", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "c1OR", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 1500643531, "strokeColor": "#e03131", "strokeStyle": "solid", "strokeWidth": 3, "updated": 1793904876558, "version": 1, "versionNonce": 1331427365}, {"id": "pc-2d-t", "type": "text", "x": 80000, "y": 2077, "width": 748, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "c1OS", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "2D \u00b7 Questions pour ta validation \u2014 ma proposition entre parenth\u00e8ses", "roughness": 1, "roundness": null, "seed": 728975028, "strokeColor": "#e03131", "strokeStyle": "solid", "strokeWidth": 2, "text": "2D \u00b7 Questions pour ta validation \u2014 ma proposition entre parenth\u00e8ses", "textAlign": "left", "updated": 1793904876558, "version": 1, "versionNonce": 516409742, "verticalAlign": "top"}, {"id": "pc-2d-b", "type": "text", "x": 80000, "y": 2121, "width": 2480, "height": 127.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": [], "index": "c1OT", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Q-A1\u00a0\u00a0Attribution sur Blue 600 : lien #3E52A3 2,32:1, Navy 950 4,08:1. (Texte et liens en Navy 950 assombri hsl(229, 23%, 16%) #1F2332 : 5,05:1 sur Blue 600, 6,34:1 sur le cercle clair.)\nQ-B1\u00a0\u00a0Statistiques. (Liste de description dl : libell\u00e9 en dt, chiffre en dd, chiffre affich\u00e9 au-dessus ; lu \u00ab Followers, 80K \u00bb.)\nQ-B2\u00a0\u00a0Photo. (alt=\"\" : le nom suit juste dessous, la photo n'ajoute pas d'information.)\nQ-B3\u00a0\u00a0Titre. (h1 \u00ab Victor Crest \u00bb ; \u00ab 26 \u00bb \u00e0 c\u00f4t\u00e9, hors du titre, en Gray 500.)\nQ-B4\u00a0\u00a0Pas de maquette tablette. (La m\u00eame carte \u00e0 toutes les largeurs : 350 px au plus, 24 px des bords en dessous ; motifs du fond plac\u00e9s par rapport au centre de la fen\u00eatre.)\nQ-B5\u00a0\u00a0Refonte. (M\u00eame d\u00e9p\u00f4t front-profile-card en v2.0.0, historique gard\u00e9 ; GitHub Pages ; \u00ab Edit solution \u00bb sur FM.)", "roughness": 1, "roundness": null, "seed": 1969113378, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "Q-A1\u00a0\u00a0Attribution sur Blue 600 : lien #3E52A3 2,32:1, Navy 950 4,08:1. (Texte et liens en Navy 950 assombri hsl(229, 23%, 16%) #1F2332 : 5,05:1 sur Blue 600, 6,34:1 sur le cercle clair.)\nQ-B1\u00a0\u00a0Statistiques. (Liste de description dl : libell\u00e9 en dt, chiffre en dd, chiffre affich\u00e9 au-dessus ; lu \u00ab Followers, 80K \u00bb.)\nQ-B2\u00a0\u00a0Photo. (alt=\"\" : le nom suit juste dessous, la photo n'ajoute pas d'information.)\nQ-B3\u00a0\u00a0Titre. (h1 \u00ab Victor Crest \u00bb ; \u00ab 26 \u00bb \u00e0 c\u00f4t\u00e9, hors du titre, en Gray 500.)\nQ-B4\u00a0\u00a0Pas de maquette tablette. (La m\u00eame carte \u00e0 toutes les largeurs : 350 px au plus, 24 px des bords en dessous ; motifs du fond plac\u00e9s par rapport au centre de la fen\u00eatre.)\nQ-B5\u00a0\u00a0Refonte. (M\u00eame d\u00e9p\u00f4t front-profile-card en v2.0.0, historique gard\u00e9 ; GitHub Pages ; \u00ab Edit solution \u00bb sur FM.)", "textAlign": "left", "updated": 1793904876559, "version": 1, "versionNonce": 909767662, "verticalAlign": "top"}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {"pc-img-d-file": {"id": "pc-img-d-file", "dataURL": "data:image/jpeg;base64,", "mimeType": "image/jpeg", "created": 1793904865040}, "pc-img-m-file": {"id": "pc-img-m-file", "dataURL": "data:image/jpeg;base64,", "mimeType": "image/jpeg", "created": 1793904865040}}}